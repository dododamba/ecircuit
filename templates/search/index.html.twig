{% extends 'layouts/admin.html.twig' %}

{% block title %}Recherche multicritère &bull; MCI e-Circuit{% endblock %}
{% block page_title %}Recherche générale{% endblock %}

{% block body %}
{% set breadcrumbs = [
    {'label': 'Tableau de bord', 'url': path('app_dashboard')},
    {'label': 'Recherche multicritère'}
] %}
{% include 'partials/breadcrumbs.html.twig' with {'breadcrumbs': breadcrumbs} %}

<!-- Entête de page avec description et action export -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-border/60 mb-6">
    <div>
        <h2 class="text-xl font-bold tracking-tight text-foreground flex items-center gap-2.5">
            <i class="ki-filled ki-magnifier text-primary text-xl"></i>
            <span>Moteur de recherche ministériel</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">
            Recherchez instantanément parmi l'ensemble des courriers, dossiers, expéditeurs et circuits du Ministère.
        </p>
    </div>

    {% if total_results > 0 %}
        <div class="flex items-center gap-2">
            <a href="{{ path('search_export', app.request.query.all) }}" class="kt-btn kt-btn-outline kt-btn-sm inline-flex items-center gap-2">
                <i class="ki-filled ki-file-down text-sm"></i>
                <span>Exporter CSV ({{ total_results }})</span>
            </a>
        </div>
    {% endif %}
</div>

<!-- Formulaire de recherche multicritère -->
<div class="kt-card bg-background border border-border/80 shadow-xs rounded-xl p-5 mb-8">
    <form method="GET" action="{{ path('search_index') }}" class="space-y-4">
        <input type="hidden" name="search_submitted" value="1"/>
        <input type="hidden" name="type" value="{{ type }}"/>

        <!-- Barre de recherche textuelle principale -->
        <div class="relative">
            <i class="ki-filled ki-magnifier absolute start-4 top-3.5 text-muted-foreground text-lg"></i>
            <input type="text" name="q" value="{{ q }}" placeholder="Recherche par référence (ex: MCI-2026-000001), objet, mot-clé, expéditeur ou organisation..." class="kt-input ps-11 pe-28 py-3 w-full rounded-xl bg-secondary/30 border border-border/80 focus:bg-background text-sm transition-all"/>
            <button type="submit" class="kt-btn kt-btn-primary kt-btn-sm absolute end-2.5 top-2.5 px-4">
                Rechercher
            </button>
        </div>

        <!-- Filtres avancés dépliables -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
            <!-- Statut -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Statut du dossier</label>
                <select name="status" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Tous les statuts</option>
                    {% for st in statuses %}
                        <option value="{{ st.code }}" {{ filters.status == st.code ? 'selected' : '' }}>{{ st.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Priorité -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Niveau de priorité</label>
                <select name="priority" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Toutes priorités</option>
                    {% for pr in priorities %}
                        <option value="{{ pr.code }}" {{ filters.priority == pr.code ? 'selected' : '' }}>{{ pr.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Canal d'entrée -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Canal d'origine</label>
                <select name="channel" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Tous canaux</option>
                    {% for ch in channels %}
                        <option value="{{ ch.value }}" {{ filters.channel == ch.value ? 'selected' : '' }}>{{ ch.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Structure actuelle -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Direction / Structure</label>
                <select name="structure_id" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Toutes structures</option>
                    {% for s in structures %}
                        <option value="{{ s.id }}" {{ filters.structure_id == s.id ? 'selected' : '' }}>{{ s.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Agent assigné -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Agent instructeur</label>
                <select name="assignee_id" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Tous les agents</option>
                    {% for ag in agents %}
                        <option value="{{ ag.id }}" {{ filters.assignee_id == ag.id ? 'selected' : '' }}>{{ ag.fullName }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Type de dossier -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Type de dossier</label>
                <select name="case_type_id" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Tous les types</option>
                    {% for ct in case_types %}
                        <option value="{{ ct.id }}" {{ filters.case_type_id == ct.id ? 'selected' : '' }}>{{ ct.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Nature du document -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Nature de pièce</label>
                <select name="document_type" class="kt-select w-full text-xs rounded-lg py-1.5 bg-background border border-border/80">
                    <option value="">Toutes pièces</option>
                    {% for dt in document_types %}
                        <option value="{{ dt.code }}" {{ filters.document_type == dt.code ? 'selected' : '' }}>{{ dt.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Date reçu début -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Reçu à partir du</label>
                <input type="date" name="date_from" value="{{ filters.date_from }}" class="kt-input w-full text-xs rounded-lg py-1.5 bg-background border border-border/80"/>
            </div>

            <!-- Date reçu fin -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Reçu jusqu'au</label>
                <input type="date" name="date_to" value="{{ filters.date_to }}" class="kt-input w-full text-xs rounded-lg py-1.5 bg-background border border-border/80"/>
            </div>

            <!-- Date création début -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Enregistré à partir du</label>
                <input type="date" name="created_from" value="{{ filters.created_from }}" class="kt-input w-full text-xs rounded-lg py-1.5 bg-background border border-border/80"/>
            </div>

            <!-- Date création fin -->
            <div>
                <label class="block text-[11px] font-semibold text-muted-foreground uppercase mb-1">Enregistré jusqu'au</label>
                <input type="date" name="created_to" value="{{ filters.created_to }}" class="kt-input w-full text-xs rounded-lg py-1.5 bg-background border border-border/80"/>
            </div>

            <!-- Options avancées & Actions -->
            <div class="sm:col-span-2 lg:col-span-4 flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-border/40">
                <label class="flex items-center gap-2 cursor-pointer text-xs text-foreground/80 self-start sm:self-center">
                    <input type="checkbox" name="overdue_only" value="1" {{ filters.overdue_only|default(false) ? 'checked' : '' }} class="rounded border-border text-danger focus:ring-danger"/>
                    <span class="text-danger font-medium flex items-center gap-1">
                        <i class="ki-filled ki-time text-xs"></i>
                        <span>Uniquement les dossiers en retard d'échéance</span>
                    </span>
                </label>

                <div class="flex items-center gap-2 self-end">
                    <a href="{{ path('search_index') }}" class="kt-btn kt-btn-ghost kt-btn-sm text-xs text-muted-foreground hover:text-foreground">
                        Réinitialiser
                    </a>
                    <button type="submit" class="kt-btn kt-btn-secondary kt-btn-sm text-xs inline-flex items-center gap-1.5">
                        <i class="ki-filled ki-filter text-xs"></i>
                        <span>Appliquer les filtres avancés</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Onglets par type d'entités -->
<div class="flex items-center gap-2 border-b border-border/60 mb-6">
    <a href="{{ path('search_index', app.request.query.all|merge({'type': 'all', 'page': 1})) }}" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors flex items-center gap-2 {{ type == 'all' ? 'border-primary text-primary font-bold' : 'border-transparent text-muted-foreground hover:text-foreground' }}">
        <span>Tous les résultats</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] {{ type == 'all' ? 'bg-primary/10 text-primary' : 'bg-secondary text-muted-foreground' }}">
            {{ total_results }}
        </span>
    </a>
    <a href="{{ path('search_index', app.request.query.all|merge({'type': 'dossier', 'page': 1})) }}" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors flex items-center gap-2 {{ type == 'dossier' ? 'border-primary text-primary font-bold' : 'border-transparent text-muted-foreground hover:text-foreground' }}">
        <span>Dossiers</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] {{ type == 'dossier' ? 'bg-primary/10 text-primary' : 'bg-secondary text-muted-foreground' }}">
            {{ dossiers_count }}
        </span>
    </a>
    <a href="{{ path('search_index', app.request.query.all|merge({'type': 'courrier', 'page': 1})) }}" class="px-4 py-2.5 text-xs font-semibold border-b-2 transition-colors flex items-center gap-2 {{ type == 'courrier' ? 'border-primary text-primary font-bold' : 'border-transparent text-muted-foreground hover:text-foreground' }}">
        <span>Courriers</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] {{ type == 'courrier' ? 'bg-primary/10 text-primary' : 'bg-secondary text-muted-foreground' }}">
            {{ correspondences_count }}
        </span>
    </a>
</div>

<!-- Liste des résultats -->
{% if total_results == 0 %}
    <div class="kt-card bg-background border border-border/80 rounded-xl p-12 text-center">
        <div class="size-16 rounded-full bg-secondary/80 flex items-center justify-center mx-auto mb-4 text-muted-foreground">
            <i class="ki-filled ki-magnifier text-3xl"></i>
        </div>
        <h3 class="text-base font-bold text-foreground mb-1">
            {% if has_search %}
                Aucun résultat correspondant
            {% else %}
                Lancez une recherche
            {% endif %}
        </h3>
        <p class="text-xs text-muted-foreground max-w-md mx-auto">
            {% if has_search %}
                Aucun dossier ou courrier ne correspond à vos critères de recherche. Essayez d'élargir les dates ou d'utiliser un terme plus général.
            {% else %}
                Saisissez un mot-clé ou appliquez des filtres ci-dessus pour rechercher dans les archives et dossiers du Ministère.
            {% endif %}
        </p>
    </div>
{% else %}
    
    <!-- SECTION DOSSIERS -->
    {% if dossiers|length > 0 %}
        <div class="mb-8">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
                    <i class="ki-filled ki-folder text-primary text-base"></i>
                    <span>Dossiers trouvés ({{ dossiers_count }})</span>
                </h3>
            </div>

            <div class="kt-card bg-background border border-border/80 shadow-xs rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-start text-xs align-middle">
                        <thead class="bg-secondary/40 text-muted-foreground uppercase tracking-wider text-[10px] font-semibold border-b border-border/60">
                            <tr>
                                <th class="py-3 px-4 text-start">Référence & Objet</th>
                                <th class="py-3 px-3 text-start">Canal</th>
                                <th class="py-3 px-3 text-start">Localisation</th>
                                <th class="py-3 px-3 text-start">Statut</th>
                                <th class="py-3 px-3 text-start">Priorité</th>
                                <th class="py-3 px-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border/40">
                            {% for c in dossiers %}
                                <tr class="hover:bg-secondary/20 transition-colors">
                                    <td class="py-3 px-4">
                                        <div class="flex flex-col gap-0.5">
                                            <a href="{{ path('dossier_show', {id: c.id}) }}" class="font-bold font-mono text-primary hover:underline text-xs">
                                                {{ c.reference }}
                                            </a>
                                            <span class="text-foreground font-medium line-clamp-1 max-w-[320px]">
                                                {{ c.subject }}
                                            </span>
                                            <span class="text-[10px] text-muted-foreground">
                                                Reçu le {{ c.receivedAt|date('d/m/Y') }}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold {{ c.entryChannel.value == 'CABINET' ? 'bg-indigo-50 text-indigo-700' : 'bg-teal-50 text-teal-700' }}">
                                            {{ c.entryChannel.label }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-3">
                                        <div class="flex flex-col">
                                            <span class="font-semibold text-foreground truncate max-w-[180px]">
                                                {{ c.currentStructure ? c.currentStructure.name : 'Cabinet central' }}
                                            </span>
                                            <span class="text-[10px] text-muted-foreground truncate max-w-[180px]">
                                                {{ c.currentAssignee ? c.currentAssignee.fullName : 'Non affecté' }}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-primary/10 text-primary">
                                            {{ c.statusCode }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold {{ c.priorityCode in ['URGENTE', 'TRES_URGENTE'] ? 'bg-destructive/10 text-destructive' : 'bg-secondary text-muted-foreground' }}">
                                            {{ c.priorityCode }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <a href="{{ path('dossier_show', {id: c.id}) }}" class="kt-btn kt-btn-ghost kt-btn-sm text-xs text-primary hover:bg-primary/10">
                                            <span>Ouvrir</span>
                                            <i class="ki-filled ki-right text-[10px] ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- SECTION COURRIERS -->
    {% if correspondences|length > 0 %}
        <div class="mb-8">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
                    <i class="ki-filled ki-sms text-primary text-base"></i>
                    <span>Courriers trouvés ({{ correspondences_count }})</span>
                </h3>
            </div>

            <div class="kt-card bg-background border border-border/80 shadow-xs rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-start text-xs align-middle">
                        <thead class="bg-secondary/40 text-muted-foreground uppercase tracking-wider text-[10px] font-semibold border-b border-border/60">
                            <tr>
                                <th class="py-3 px-4 text-start">Référence & Objet</th>
                                <th class="py-3 px-3 text-start">Expéditeur</th>
                                <th class="py-3 px-3 text-start">Canal</th>
                                <th class="py-3 px-3 text-start">Statut</th>
                                <th class="py-3 px-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border/40">
                            {% for corr in correspondences %}
                                <tr class="hover:bg-secondary/20 transition-colors">
                                    <td class="py-3 px-4">
                                        <div class="flex flex-col gap-0.5">
                                            <a href="{{ path('courrier_show', {id: corr.id}) }}" class="font-bold font-mono text-primary hover:underline text-xs">
                                                {{ corr.reference }}
                                            </a>
                                            <span class="text-foreground font-medium line-clamp-1 max-w-[320px]">
                                                {{ corr.subject }}
                                            </span>
                                            <span class="text-[10px] text-muted-foreground">
                                                Reçu le {{ corr.receivedAt|date('d/m/Y') }}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3">
                                        <div class="flex flex-col">
                                            <span class="font-semibold text-foreground">
                                                {{ corr.sender ? corr.sender.name : 'Expéditeur anonyme' }}
                                            </span>
                                            <span class="text-[10px] text-muted-foreground">
                                                {{ corr.sender and corr.sender.organisation ? corr.sender.organisation : 'Particulier' }}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold {{ corr.channel.value == 'CABINET' ? 'bg-indigo-50 text-indigo-700' : 'bg-teal-50 text-teal-700' }}">
                                            {{ corr.channel.label }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-primary/10 text-primary">
                                            {{ corr.status.label }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <a href="{{ path('courrier_show', {id: corr.id}) }}" class="kt-btn kt-btn-ghost kt-btn-sm text-xs text-primary hover:bg-primary/10">
                                            <span>Consulter</span>
                                            <i class="ki-filled ki-right text-[10px] ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

{% endif %}
{% endblock %}
