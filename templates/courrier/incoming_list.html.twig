{% extends 'layouts/admin.html.twig' %}

{% block title %}Registre des Courriers Entrants — MCI e-Circuit{% endblock %}
{% block page_title %}Registre des Courriers Entrants{% endblock %}

{% block body %}
<div class="flex flex-col gap-6">

    <!-- KPI / Statistics Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="kt-card kt-card-kpi p-5 flex flex-row items-center justify-between">
            <div class="flex flex-col">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Total Courriers</span>
                <span class="text-2xl font-bold text-foreground mt-1">{{ stats.total }}</span>
                <span class="text-[11px] text-muted-foreground mt-0.5">Enregistrés dans le registre</span>
            </div>
            <div class="size-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                <i class="ki-filled ki-file-sheet text-xl"></i>
            </div>
        </div>

        <div class="kt-card kt-card-kpi p-5 flex flex-row items-center justify-between">
            <div class="flex flex-col">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Urgences actives</span>
                <span class="text-2xl font-bold text-destructive mt-1">{{ stats.urgent }}</span>
                <span class="text-[11px] text-destructive/80 mt-0.5">Priorité Urgente / Très Urgente</span>
            </div>
            <div class="size-11 rounded-xl bg-destructive/10 text-destructive flex items-center justify-center shrink-0">
                <i class="ki-filled ki-flash text-xl"></i>
            </div>
        </div>

        <div class="kt-card kt-card-kpi p-5 flex flex-row items-center justify-between">
            <div class="flex flex-col">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Aujourd'hui</span>
                <span class="text-2xl font-bold text-info mt-1">{{ stats.today }}</span>
                <span class="text-[11px] text-muted-foreground mt-0.5">Reçus ce jour</span>
            </div>
            <div class="size-11 rounded-xl bg-info/10 text-info flex items-center justify-center shrink-0">
                <i class="ki-filled ki-calendar text-xl"></i>
            </div>
        </div>

        <div class="kt-card kt-card-kpi p-5 flex flex-row items-center justify-between">
            <div class="flex flex-col">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Validés & Actifs</span>
                <span class="text-2xl font-bold text-success mt-1">{{ stats.registered }}</span>
                <span class="text-[11px] text-success/80 mt-0.5">Prêts pour instruction</span>
            </div>
            <div class="size-11 rounded-xl bg-success/10 text-success flex items-center justify-center shrink-0">
                <i class="ki-filled ki-check-circle text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Actions & Filter Bar -->
    <div class="kt-card kt-card-data overflow-hidden">
        <div class="p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border/60">
            <div>
                <h2 class="text-base font-bold text-foreground">Registre Chronologique des Entrées</h2>
                <p class="text-xs text-muted-foreground mt-0.5">Traçabilité complète et immuable des courriers officiels reçus par le Ministère</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <a href="{{ path('courrier_incoming_new') }}" class="kt-btn kt-btn-primary kt-btn-sm py-2.5 px-4 inline-flex items-center gap-2 shadow-xs">
                    <i class="ki-filled ki-plus text-xs"></i>
                    <span>Enregistrer un courrier</span>
                </a>
            </div>
        </div>

        <!-- Filtres avancés -->
        <form method="get" action="{{ path('courrier_incoming_list') }}" class="p-5 bg-secondary/10 border-b border-border/40 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
            <div class="flex flex-col gap-1 lg:col-span-2">
                <label for="search" class="text-[11px] font-semibold text-foreground">Recherche libre</label>
                <div class="relative">
                    <i class="ki-filled ki-magnifier text-xs text-muted-foreground absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input 
                        type="text" 
                        id="search" 
                        name="search" 
                        value="{{ filters.search|default('') }}" 
                        placeholder="Réf, objet, expéditeur..." 
                        class="kt-input pl-8 pr-3 py-1.5 w-full text-xs rounded-lg border border-border bg-background"
                    >
                </div>
            </div>

            <div class="flex flex-col gap-1">
                <label for="channel" class="text-[11px] font-semibold text-foreground">Canal d'entrée</label>
                <select id="channel" name="channel" class="kt-select px-2.5 py-1.5 text-xs rounded-lg border border-border bg-background">
                    <option value="">Tous les canaux</option>
                    {% for ch in channels %}
                        <option value="{{ ch.value }}" {{ filters.channel|default('') == ch.value ? 'selected' : '' }}>
                            {{ ch.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex flex-col gap-1">
                <label for="priority" class="text-[11px] font-semibold text-foreground">Priorité</label>
                <select id="priority" name="priority" class="kt-select px-2.5 py-1.5 text-xs rounded-lg border border-border bg-background">
                    <option value="">Toutes priorités</option>
                    {% for p in priorities %}
                        <option value="{{ p.code }}" {{ filters.priority|default('') == p.code ? 'selected' : '' }}>
                            {{ p.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex flex-col gap-1">
                <label for="date_from" class="text-[11px] font-semibold text-foreground">Date début</label>
                <input 
                    type="date" 
                    id="date_from" 
                    name="date_from" 
                    value="{{ filters.dateFrom|default('') }}" 
                    class="kt-input px-2.5 py-1.5 text-xs rounded-lg border border-border bg-background"
                >
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="kt-btn kt-btn-primary kt-btn-sm py-2 px-3 grow flex items-center justify-center gap-1.5 text-xs">
                    <i class="ki-filled ki-filter text-xs"></i>
                    <span>Filtrer</span>
                </button>
                {% if filters.search or filters.channel or filters.priority or filters.dateFrom or filters.dateTo %}
                    <a href="{{ path('courrier_incoming_list') }}" class="kt-btn kt-btn-ghost kt-btn-sm py-2 px-2.5 text-xs text-muted-foreground hover:text-foreground shrink-0" title="Réinitialiser">
                        <i class="ki-filled ki-cross text-xs"></i>
                    </a>
                {% endif %}
            </div>
        </form>

        <!-- Tableau des courriers -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary/20 border-b border-border text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">
                        <th class="py-3 px-4">Référence</th>
                        <th class="py-3 px-4">Date Réception</th>
                        <th class="py-3 px-4">Expéditeur</th>
                        <th class="py-3 px-4">Objet</th>
                        <th class="py-3 px-4">Priorité</th>
                        <th class="py-3 px-4">Canal</th>
                        <th class="py-3 px-4">Document</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/60 text-xs">
                    {% for c in correspondences %}
                        <tr class="hover:bg-secondary/15 transition-colors">
                            <td class="py-3.5 px-4 whitespace-nowrap">
                                <a href="{{ path('courrier_show', {id: c.id}) }}" class="font-mono font-bold text-primary hover:underline flex items-center gap-1.5">
                                    <i class="ki-filled ki-barcode text-xs text-muted-foreground"></i>
                                    <span>{{ c.reference }}</span>
                                </a>
                            </td>
                            <td class="py-3.5 px-4 whitespace-nowrap text-muted-foreground">
                                {{ c.receivedAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="font-medium text-foreground">{{ c.sender ? c.sender.name : '—' }}</div>
                                {% if c.sender and c.sender.organisation %}
                                    <div class="text-[11px] text-muted-foreground truncate max-w-[200px]">{{ c.sender.organisation }}</div>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-4 max-w-xs">
                                <div class="font-medium text-foreground truncate" title="{{ c.subject }}">{{ c.subject }}</div>
                                {% if c.documentType %}
                                    <span class="inline-block mt-0.5 text-[10px] text-muted-foreground bg-secondary/50 px-1.5 py-0.5 rounded">
                                        {{ c.documentType.label }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-4 whitespace-nowrap">
                                {% if c.priority %}
                                    {% set pCode = c.priority.code %}
                                    {% set badgeColor = pCode in ['URGENTE', 'URGENT'] ? 'bg-orange-500/10 text-orange-600 border-orange-500/30' : (pCode == 'TRES_URGENTE' ? 'bg-destructive/10 text-destructive border-destructive/30' : 'bg-secondary text-muted-foreground border-border') %}
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-semibold rounded-full border {{ badgeColor }}">
                                        {{ c.priority.label }}
                                    </span>
                                {% else %}
                                    <span class="text-muted-foreground text-[11px]">—</span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-medium rounded-full bg-secondary text-foreground">
                                    {{ c.entryChannel.label }}
                                </span>
                            </td>
                            <td class="py-3.5 px-4 whitespace-nowrap">
                                {% if c.mainDocument %}
                                    <a href="{{ path('document_download', {id: c.mainDocument.id}) }}" target="_blank" class="inline-flex items-center gap-1 text-[11px] text-primary hover:underline" title="{{ c.mainDocument.originalName }}">
                                        <i class="ki-filled ki-document text-sm"></i>
                                        <span>PDF ({{ (c.mainDocument.size / 1024)|round }} Ko)</span>
                                    </a>
                                {% else %}
                                    <span class="text-muted-foreground text-[11px]">Aucun</span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1">
                                    <a href="{{ path('courrier_show', {id: c.id}) }}" class="kt-btn kt-btn-ghost kt-btn-icon kt-btn-xs text-muted-foreground hover:text-primary" title="Consulter la fiche">
                                        <i class="ki-filled ki-eye text-xs"></i>
                                    </a>
                                    <a href="{{ path('courrier_routing_slip', {id: c.id}) }}" target="_blank" class="kt-btn kt-btn-ghost kt-btn-icon kt-btn-xs text-muted-foreground hover:text-foreground" title="Fiche suiveuse imprimable">
                                        <i class="ki-filled ki-printer text-xs"></i>
                                    </a>
                                    <a href="{{ path('courrier_receipt', {id: c.id}) }}" target="_blank" class="kt-btn kt-btn-ghost kt-btn-icon kt-btn-xs text-muted-foreground hover:text-foreground" title="Récépissé de dépôt">
                                        <i class="ki-filled ki-badge text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="py-12 text-center text-muted-foreground">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <i class="ki-filled ki-folder-open text-3xl opacity-40"></i>
                                    <span class="text-sm font-medium">Aucun courrier entrant ne correspond aux critères de recherche.</span>
                                    <a href="{{ path('courrier_incoming_new') }}" class="kt-btn kt-btn-primary kt-btn-xs mt-2">
                                        Enregistrer le premier courrier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if total_pages > 1 %}
            <div class="p-4 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
                <div>Affichage de {{ correspondences|length }} sur {{ total_count }} courriers</div>
                <div class="flex items-center gap-1">
                    {% if current_page > 1 %}
                        <a href="{{ path('courrier_incoming_list', filters|merge({'page': current_page - 1})) }}" class="kt-btn kt-btn-outline kt-btn-xs">Précédent</a>
                    {% endif %}
                    <span class="px-2">Page {{ current_page }} / {{ total_pages }}</span>
                    {% if current_page < total_pages %}
                        <a href="{{ path('courrier_incoming_list', filters|merge({'page': current_page + 1})) }}" class="kt-btn kt-btn-outline kt-btn-xs">Suivant</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
