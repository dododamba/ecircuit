{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set alertClass = type == 'success' ? 'kt-alert-success' : (type == 'error' or type == 'danger' ? 'kt-alert-destructive' : (type == 'warning' ? 'kt-alert-warning' : 'kt-alert-info')) %}
        {% set iconClass = type == 'success' ? 'ki-check-circle text-success' : (type == 'error' or type == 'danger' ? 'ki-cross-circle text-destructive' : (type == 'warning' ? 'ki-information-2 text-warning' : 'ki-information text-info')) %}

        <div class="kt-alert {{ alertClass }} kt-alert-light shadow-sm rounded-xl mb-4 p-4 flex items-center justify-between gap-3 mci-auto-dismiss" role="alert">
            <div class="flex items-center gap-3">
                <i class="ki-filled {{ iconClass }} text-xl shrink-0"></i>
                <div class="text-sm font-medium leading-relaxed">
                    {{ message|trans }}
                </div>
            </div>
            <button type="button" class="kt-btn kt-btn-icon kt-btn-ghost kt-btn-sm text-muted-foreground hover:text-foreground shrink-0" onclick="this.closest('.kt-alert').remove()" aria-label="Fermer">
                <i class="ki-filled ki-cross text-xs"></i>
            </button>
        </div>
    {% endfor %}
{% endfor %}
