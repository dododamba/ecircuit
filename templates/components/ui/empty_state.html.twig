{# 
  État Vide UI Réutilisable Metronic
  Paramètres:
  - title: titre (ex: "Aucun enregistrement trouvé")
  - description: texte d'explication
  - icon: code keenicon (défaut 'information-2')
  - action_label: libellé du bouton optionnel
  - action_url: lien d'action optionnel
#}
<div class="flex flex-col items-center justify-center p-12 text-center">
    <div class="size-16 rounded-full bg-secondary/80 text-muted-foreground flex items-center justify-center mb-4">
        <i class="ki-filled ki-{{ icon|default('information-2') }} text-3xl"></i>
    </div>
    <h4 class="text-base font-semibold text-foreground mb-1">
        {{ title|default('Aucune donnée disponible') }}
    </h4>
    <p class="text-xs text-muted-foreground max-w-sm mb-6 leading-relaxed">
        {{ description|default('Il n\'y a actuellement aucun élément à afficher dans cette vue.') }}
    </p>
    {% if action_label is defined and action_label and action_url is defined and action_url %}
        <a href="{{ action_url }}" class="kt-btn kt-btn-primary kt-btn-sm inline-flex items-center gap-2">
            <i class="ki-filled ki-plus text-xs"></i>
            <span>{{ action_label }}</span>
        </a>
    {% endif %}
</div>
