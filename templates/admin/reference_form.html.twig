{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ edit ? 'Modifier l\'élément' : 'Nouvel élément de nomenclature' }} &bull; MCI e-Circuit{% endblock %}
{% block page_title %}{{ edit ? 'Édition Référentiel' : 'Nouveau Référentiel' }}{% endblock %}

{% block body %}
{% set breadcrumbs = [
    {'label': 'Administration', 'url': path('admin_users')},
    {'label': 'Référentiels', 'url': path('admin_references', {'category': category.slug})},
    {'label': category.label, 'url': path('admin_references', {'category': category.slug})},
    {'label': edit ? 'Modifier ' ~ item.label : 'Nouvel élément'}
] %}
{% include 'partials/breadcrumbs.html.twig' with {'breadcrumbs': breadcrumbs} %}

<!-- En-tête -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-border/60 mb-6">
    <div>
        <h2 class="text-xl font-bold tracking-tight text-foreground">
            {{ edit ? 'Modification : ' ~ item.label : 'Ajout d\'un élément de nomenclature' }}
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">
            Catégorie : <strong class="text-primary">{{ category.label }}</strong> &bull; {{ edit ? 'Modifiez le libellé institutionnel ou les propriétés d\'affichage.' : 'Définissez le code et les paramètres de la nouvelle entrée.' }}
        </p>
    </div>
    <a href="{{ path('admin_references', {'category': category.slug}) }}" class="kt-btn kt-btn-outline kt-btn-sm inline-flex items-center gap-1.5">
        <i class="ki-filled ki-arrow-left text-xs"></i>
        <span>Retour aux référentiels</span>
    </a>
</div>

<!-- Formulaire Metronic -->
<div class="max-w-2xl mx-auto">
    <form method="post" action="{{ edit ? path('admin_reference_edit', {category: category.slug, id: item.id}) : path('admin_reference_new', {category: category.slug}) }}" class="flex flex-col gap-6">
        <input type="hidden" name="_token" value="{{ edit ? csrf_token('admin_ref_edit_' ~ item.id) : csrf_token('admin_ref_new') }}">

        <div class="kt-card kt-card-form overflow-hidden">
            <div class="kt-card-header">
                <div class="flex items-center gap-3">
                    <div class="kt-card-icon">
                        <i class="ki-filled ki-element-plus"></i>
                    </div>
                    <h3 class="kt-card-title">Détails de l'élément</h3>
                </div>
                <span class="kt-badge kt-badge-primary kt-badge-outline kt-badge-sm px-2.5 py-0.5 rounded-full text-[10px] font-semibold">
                    {{ category.value }}
                </span>
            </div>
            
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Code -->
                <div class="flex flex-col gap-1.5">
                    <label for="code" class="text-xs font-semibold text-foreground">
                        Code technique unique <span class="text-destructive">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="code" 
                        name="code" 
                        required 
                        {{ edit ? 'readonly disabled' : '' }} 
                        value="{{ edit ? item.code : '' }}" 
                        class="kt-input px-3 py-2 w-full text-xs font-mono uppercase rounded-lg border border-border {{ edit ? 'bg-secondary/40 text-muted-foreground' : 'bg-background' }}" 
                        placeholder="ex: URGENT, DECISION..."
                    >
                    {% if edit %}
                        <span class="text-[10px] text-muted-foreground">Le code technique est immuable.</span>
                    {% endif %}
                </div>

                <!-- Libellé -->
                <div class="flex flex-col gap-1.5">
                    <label for="label" class="text-xs font-semibold text-foreground">
                        Libellé officiel <span class="text-destructive">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="label" 
                        name="label" 
                        required 
                        value="{{ edit ? item.label : '' }}" 
                        class="kt-input px-3 py-2 w-full text-xs rounded-lg border border-border bg-background" 
                        placeholder="ex: Très urgente, Note..."
                    >
                </div>

                <!-- Description -->
                <div class="flex flex-col gap-1.5 sm:col-span-2">
                    <label for="description" class="text-xs font-semibold text-foreground">
                        Description / Définition d'usage
                    </label>
                    <textarea 
                        id="description" 
                        name="description" 
                        rows="2" 
                        class="kt-input px-3 py-2 w-full text-xs rounded-lg border border-border bg-background" 
                        placeholder="Précisez la portée de cet élément dans la circulation des dossiers..."
                    >{{ edit ? item.description : '' }}</textarea>
                </div>

                <!-- Couleur UI / Badge -->
                <div class="flex flex-col gap-1.5">
                    <label for="uiColor" class="text-xs font-semibold text-foreground">
                        Couleur d'affichage (Badge UI)
                    </label>
                    <select id="uiColor" name="uiColor" class="kt-select px-3 py-2 w-full text-xs rounded-lg border border-border bg-background">
                        <option value="">Par défaut (Gris)</option>
                        <option value="blue" {{ edit and item.uiColor == 'blue' ? 'selected' : '' }}>Bleu (Information)</option>
                        <option value="green" {{ edit and item.uiColor == 'green' ? 'selected' : '' }}>Vert (Succès / Validation)</option>
                        <option value="orange" {{ edit and item.uiColor == 'orange' ? 'selected' : '' }}>Orange (Attention / Urgent)</option>
                        <option value="red" {{ edit and item.uiColor == 'red' ? 'selected' : '' }}>Rouge (Critique / Très urgent)</option>
                        <option value="purple" {{ edit and item.uiColor == 'purple' ? 'selected' : '' }}>Violet (Instruction)</option>
                        <option value="teal" {{ edit and item.uiColor == 'teal' ? 'selected' : '' }}>Teal (Partenaire / Échange)</option>
                    </select>
                </div>

                <!-- Ordre d'affichage -->
                <div class="flex flex-col gap-1.5">
                    <label for="display_order" class="text-xs font-semibold text-foreground">
                        Ordre de tri
                    </label>
                    <input 
                        type="number" 
                        id="display_order" 
                        name="display_order" 
                        min="0" 
                        value="{{ edit ? item.displayOrder : 0 }}" 
                        class="kt-input px-3 py-2 w-full text-xs rounded-lg border border-border bg-background"
                    >
                </div>

                {% if edit %}
                    <!-- Statut -->
                    <div class="flex flex-col gap-1.5 sm:col-span-2">
                        <label for="active" class="text-xs font-semibold text-foreground">
                            Statut de l'entrée
                        </label>
                        <select id="active" name="active" class="kt-select px-3 py-2 w-full text-xs rounded-lg border border-border bg-background">
                            <option value="1" {{ item.active ? 'selected' : '' }}>Actif (Disponible pour sélection)</option>
                            <option value="0" {{ not item.active ? 'selected' : '' }}>Désactivé (Masqué des listes)</option>
                        </select>
                    </div>
                {% endif %}

            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 pb-12 border-t border-border/40 mt-2">
            <a href="{{ path('admin_references', {'category': category.slug}) }}" class="kt-btn kt-btn-outline kt-btn-md px-5 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground">
                Annuler et retourner
            </a>
            <button type="submit" class="kt-btn kt-btn-primary kt-btn-md px-7 py-2.5 shadow-sm font-semibold inline-flex items-center gap-2 text-xs">
                <i class="ki-filled ki-check text-xs"></i>
                <span>{{ edit ? 'Enregistrer les modifications' : 'Ajouter au référentiel' }}</span>
            </button>
        </div>
    </form>
</div>
{% endblock %}
