{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ edit ? 'Modifier le rôle' : 'Créer un rôle' }} &bull; MCI e-Circuit{% endblock %}
{% block page_title %}{{ edit ? 'Édition Rôle' : 'Nouveau Rôle' }}{% endblock %}

{% block body %}
{% set breadcrumbs = [
    {'label': 'Administration', 'url': path('admin_users')},
    {'label': 'Rôles & Permissions', 'url': path('admin_roles')},
    {'label': edit ? 'Modifier ' ~ role.label : 'Nouveau rôle'}
] %}
{% include 'partials/breadcrumbs.html.twig' with {'breadcrumbs': breadcrumbs} %}

<!-- En-tête -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-border/60 mb-6">
    <div>
        <h2 class="text-xl font-bold tracking-tight text-foreground">
            {{ edit ? 'Modification du rôle : ' ~ role.label : 'Création d\'un rôle institutionnel' }}
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">
            Définissez les prérogatives et les permissions applicables aux agents détenteurs de ce rôle.
        </p>
    </div>
    <a href="{{ path('admin_roles') }}" class="kt-btn kt-btn-outline kt-btn-sm inline-flex items-center gap-1.5">
        <i class="ki-filled ki-arrow-left text-xs"></i>
        <span>Retour aux rôles</span>
    </a>
</div>

<div class="max-w-4xl mx-auto">
    <form method="post" action="{{ edit ? path('admin_role_edit', {id: role.id}) : path('admin_role_new') }}" class="flex flex-col gap-6">
        <input type="hidden" name="_token" value="{{ edit ? csrf_token('admin_role_edit_' ~ role.id) : csrf_token('admin_role_new') }}">

        <!-- Carte Définition -->
        <div class="kt-card kt-card-form overflow-hidden">
            <div class="kt-card-header">
                <div class="flex items-center gap-3">
                    <div class="kt-card-icon">
                        <i class="ki-filled ki-shield-tick"></i>
                    </div>
                    <h3 class="kt-card-title">Informations du rôle</h3>
                </div>
            </div>
            
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                    <label for="code" class="text-xs font-semibold text-foreground">Identifiant technique (Code) <span class="text-destructive">*</span></label>
                    <input type="text" id="code" name="code" required {{ edit ? 'readonly disabled' : '' }} value="{{ edit ? role.code : '' }}" class="kt-input px-3 py-2 w-full text-xs font-mono uppercase rounded-lg border border-border {{ edit ? 'bg-secondary/40 text-muted-foreground' : 'bg-background' }}" placeholder="ex: SERVICE_COURRIER">
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="label" class="text-xs font-semibold text-foreground">Libellé institutionnel <span class="text-destructive">*</span></label>
                    <input type="text" id="label" name="label" required value="{{ edit ? role.label : '' }}" class="kt-input px-3 py-2 w-full text-xs rounded-lg border border-border bg-background" placeholder="ex: Service Courrier">
                </div>

                <div class="flex flex-col gap-1.5 sm:col-span-2">
                    <label for="description" class="text-xs font-semibold text-foreground">Description du rôle & missions</label>
                    <textarea id="description" name="description" rows="2" class="kt-input px-3 py-2 w-full text-xs rounded-lg border border-border bg-background" placeholder="Description des attributions...">{{ edit ? role.description : '' }}</textarea>
                </div>
            </div>
        </div>

        <!-- Carte Matrice de Permissions -->
        <div class="kt-card kt-card-form overflow-hidden">
            <div class="kt-card-header">
                <div class="flex items-center gap-3">
                    <div class="kt-card-icon">
                        <i class="ki-filled ki-security-check"></i>
                    </div>
                    <h3 class="kt-card-title">Habilitations & Permissions associées</h3>
                </div>
            </div>
            
            <div class="p-6 flex flex-col gap-6">
                {# Regrouper les permissions par module #}
                {% set modules = {} %}
                {% for perm in permissions %}
                    {% set mod = perm.module %}
                    {% set list = modules[mod]|default([]) %}
                    {% set modules = modules|merge({ (mod): list|merge([perm]) }) %}
                {% endfor %}

                {% for moduleName, modulePerms in modules %}
                    <div class="flex flex-col gap-3 pb-4 border-b border-border/40 last:border-0 last:pb-0">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-primary">
                            {{ moduleName }}
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                            {% for perm in modulePerms %}
                                {% set isChecked = edit and role.hasPermission(perm.code) %}
                                <label class="flex items-start gap-2.5 p-3 rounded-lg border border-border bg-secondary/10 hover:bg-secondary/30 cursor-pointer transition-colors">
                                    <input type="checkbox" name="permissions[]" value="{{ perm.code }}" {{ isChecked ? 'checked' : '' }} class="mt-0.5 rounded text-primary focus:ring-primary">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-semibold text-foreground leading-tight">{{ perm.label }}</span>
                                        <code class="text-[10px] font-mono text-muted-foreground mt-0.5">{{ perm.code }}</code>
                                    </div>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 pb-12 border-t border-border/40 mt-2">
            <a href="{{ path('admin_roles') }}" class="kt-btn kt-btn-outline kt-btn-md px-5 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground">
                Annuler et retourner
            </a>
            <button type="submit" class="kt-btn kt-btn-primary kt-btn-md px-7 py-2.5 shadow-sm font-semibold inline-flex items-center gap-2 text-xs">
                <i class="ki-filled ki-check text-xs"></i>
                <span>{{ edit ? 'Enregistrer les modifications' : 'Créer le rôle' }}</span>
            </button>
        </div>
    </form>
</div>
{% endblock %}
