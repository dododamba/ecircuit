{% extends 'layouts/auth.html.twig' %}

{% block title %}Nouveau mot de passe &bull; MCI e-Circuit{% endblock %}

{% block body %}
<div class="flex flex-col gap-6">
    
    <div class="flex flex-col gap-1">
        <h2 class="auth-heading">
            Nouveau mot de passe
        </h2>
        <p class="auth-subheading">
            Choisissez un mot de passe robuste conforme aux normes de sécurité ministérielles (12 caractères minimum).
        </p>
    </div>

    <form method="post" action="{{ path('app_password_reset', {'token': token}) }}" class="flex flex-col gap-4">
        
        <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}"/>
        <input type="hidden" name="token" value="{{ token }}"/>

        <div class="auth-form-group">
            <label for="password" class="auth-label">
                Nouveau mot de passe
            </label>
            <div class="auth-input-wrapper">
                <i class="ki-filled ki-key auth-input-icon"></i>
                <input 
                    id="password" 
                    name="password" 
                    type="password" 
                    minlength="12" 
                    autocomplete="new-password" 
                    required 
                    placeholder="12 caractères minimum"
                    class="auth-input"
                />
            </div>
        </div>

        <div class="auth-form-group">
            <label for="password_confirmation" class="auth-label">
                Confirmez le nouveau mot de passe
            </label>
            <div class="auth-input-wrapper">
                <i class="ki-filled ki-key auth-input-icon"></i>
                <input 
                    id="password_confirmation" 
                    name="password_confirmation" 
                    type="password" 
                    minlength="12" 
                    autocomplete="new-password" 
                    required 
                    placeholder="Répétez le mot de passe"
                    class="auth-input"
                />
            </div>
        </div>

        <button type="submit" class="auth-submit-btn">
            <span>Mettre à jour le mot de passe</span>
            <i class="ki-filled ki-check-circle text-xs"></i>
        </button>

    </form>

</div>
{% endblock %}
