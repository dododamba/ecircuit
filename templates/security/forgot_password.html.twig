{% extends 'layouts/auth.html.twig' %}

{% block title %}Mot de passe oublié &bull; MCI e-Circuit{% endblock %}

{% block body %}
<div class="flex flex-col gap-6">
    
    <div class="flex flex-col gap-1">
        <a href="{{ path('app_login') }}" class="auth-link inline-flex items-center gap-1.5 mb-2">
            <i class="ki-filled ki-arrow-left text-xs"></i>
            <span>Retour à la connexion</span>
        </a>
        <h2 class="auth-heading">
            Récupération d'accès
        </h2>
        <p class="auth-subheading">
            Indiquez votre adresse e-mail institutionnelle pour recevoir un lien sécurisé à usage unique.
        </p>
    </div>

    <form method="post" action="{{ path('app_password_forgot') }}" class="flex flex-col gap-4">
        
        <div class="auth-form-group">
            <label for="email" class="auth-label">
                Adresse e-mail institutionnelle
            </label>
            <div class="auth-input-wrapper">
                <i class="ki-filled ki-sms auth-input-icon"></i>
                <input 
                    id="email" 
                    name="email" 
                    type="email" 
                    autocomplete="email" 
                    required 
                    autofocus
                    placeholder="prenom.nom@mci.gov"
                    class="auth-input"
                />
            </div>
        </div>

        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}"/>

        <button type="submit" class="auth-submit-btn">
            <span>Envoyer le lien de réinitialisation</span>
            <i class="ki-filled ki-send text-xs"></i>
        </button>

    </form>

</div>
{% endblock %}
