<!-- MODAL ACTION DE WORKFLOW DYNAMIQUE (MODULE 7) -->
<div id="modal-workflow-action" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center hidden p-4">
    <div class="bg-background border border-border rounded-xl shadow-xl max-w-lg w-full p-6 text-xs animate-in fade-in zoom-in-95 duration-200">
        <div class="flex items-center justify-between pb-3 border-b border-border/80 mb-4">
            <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
                <i id="wf-modal-icon" class="ki-filled ki-send text-primary text-base"></i>
                <span id="wf-modal-title">Exécuter l'action de workflow</span>
            </h3>
            <button type="button" onclick="document.getElementById('modal-workflow-action').classList.add('hidden')" class="text-muted-foreground hover:text-foreground">
                <i class="ki-filled ki-cross text-sm"></i>
            </button>
        </div>

        <form method="post" action="{{ path('dossier_workflow_action', {id: case.id}) }}" class="flex flex-col gap-4" id="wf-action-form">
            <input type="hidden" name="_token" value="{{ csrf_token('workflow_action_' ~ case.id) }}">
            <input type="hidden" name="action" id="wf-action-input" value="">

            <div class="p-3 rounded-lg bg-secondary/20 border border-border/60 flex items-center justify-between">
                <div>
                    <span class="text-[11px] text-muted-foreground block">Étape actuelle</span>
                    <strong class="text-foreground font-semibold">{{ workflow_instance ? workflow_instance.currentStep.name : 'N/A' }}</strong>
                </div>
                <i class="ki-filled ki-arrow-right text-muted-foreground text-sm"></i>
                <div class="text-right">
                    <span class="text-[11px] text-muted-foreground block">Étape cible</span>
                    <strong class="text-primary font-semibold" id="wf-modal-target-step">—</strong>
                </div>
            </div>

            <!-- Structure cible (pour ORIENT ou FORWARD) -->
            <div id="wf-structure-group" class="flex flex-col gap-1.5 hidden">
                <label for="wf-target-structure" class="font-semibold text-foreground">Structure destinataire</label>
                <select id="wf-target-structure" name="target_structure_id" class="kt-select p-2 border border-border rounded-lg bg-background text-xs">
                    <option value="">Sélectionner une structure...</option>
                    {% for s in structures %}
                        <option value="{{ s.id }}">{{ s.name }} ({{ s.code }})</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Assignataire (pour ASSIGN) -->
            <div id="wf-assignee-group" class="flex flex-col gap-1.5 hidden">
                <label for="wf-assignee" class="font-semibold text-foreground">Agent instructeur / traitant</label>
                <select id="wf-assignee" name="assignee_id" class="kt-select p-2 border border-border rounded-lg bg-background text-xs">
                    <option value="">Sélectionner un agent...</option>
                    {% for a in agents %}
                        <option value="{{ a.id }}">{{ a.fullName }} ({{ a.organizationUnit ? a.organizationUnit.name : 'Sans structure' }})</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Commentaire / Instruction / Justification -->
            <div class="flex flex-col gap-1.5">
                <label for="wf-comment" class="font-semibold text-foreground flex items-center justify-between">
                    <span id="wf-comment-label">Commentaire / Consignes</span>
                    <span id="wf-comment-required-tag" class="text-destructive text-[11px] font-normal hidden">* Obligatoire</span>
                </label>
                <textarea id="wf-comment" name="comment" rows="3" placeholder="Saisissez vos observations, motifs, directives ou conclusions..." class="kt-input p-2 text-xs border border-border rounded-lg bg-background resize-y"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-border/80">
                <button type="button" onclick="document.getElementById('modal-workflow-action').classList.add('hidden')" class="kt-btn kt-btn-outline kt-btn-sm py-2 px-3">
                    Annuler
                </button>
                <button type="submit" id="wf-modal-submit-btn" class="kt-btn kt-btn-primary kt-btn-sm py-2 px-4 shadow-xs flex items-center gap-1.5">
                    <i class="ki-filled ki-check text-xs"></i>
                    <span id="wf-modal-btn-label">Confirmer</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openWorkflowActionModal(action, actionLabel, targetStepName, commentRequired, iconName, defaultStructureId) {
    document.getElementById('wf-action-input').value = action;
    document.getElementById('wf-modal-title').textContent = actionLabel;
    document.getElementById('wf-modal-btn-label').textContent = actionLabel;
    document.getElementById('wf-modal-target-step').textContent = targetStepName || 'Étape cible';
    
    var iconEl = document.getElementById('wf-modal-icon');
    iconEl.className = 'ki-filled ' + (iconName || 'ki-send') + ' text-primary text-base';

    var commentField = document.getElementById('wf-comment');
    var commentReqTag = document.getElementById('wf-comment-required-tag');
    var commentLabel = document.getElementById('wf-comment-label');
    
    if (commentRequired || action === 'REJECT' || action === 'RETURN') {
        commentField.required = true;
        commentReqTag.classList.remove('hidden');
        commentLabel.textContent = (action === 'REJECT' ? 'Motif formel de rejet' : (action === 'RETURN' ? 'Motif du retour' : 'Commentaire obligatoire'));
    } else {
        commentField.required = false;
        commentReqTag.classList.add('hidden');
        commentLabel.textContent = 'Commentaire / Consignes (Optionnel)';
    }

    var structGroup = document.getElementById('wf-structure-group');
    var structSelect = document.getElementById('wf-target-structure');
    if (action === 'ORIENT' || action === 'FORWARD') {
        structGroup.classList.remove('hidden');
        if (defaultStructureId) {
            structSelect.value = defaultStructureId;
        }
    } else {
        structGroup.classList.add('hidden');
    }

    var assigneeGroup = document.getElementById('wf-assignee-group');
    if (action === 'ASSIGN') {
        assigneeGroup.classList.remove('hidden');
    } else {
        assigneeGroup.classList.add('hidden');
    }

    document.getElementById('modal-workflow-action').classList.remove('hidden');
}
</script>

{% endblock %}
